# Copy this file to .env and fill in your real key.
# .env is in .gitignore -- it will never be committed.
# NEVER put your real key directly in this file if this repo is public and
# you might `git add -A` carelessly; .env.example should stay fake forever.

SIG_API_KEY=your-api-key-here

# Optional overrides
# SIG_BASE_URL=https://www.thesuper.market/api/v1
# SIG_TOURNAMENT_SLUG=midterm-elections-2026

# Required ONLY to allow --live in a non-interactive session (CI/cloud).
# Leave unset for dry-run/scan use. Set as a real secret, never in this file,
# when you're ready to actually go live from automation.
# SIG_BOT_CONFIRM_LIVE=YES-I-UNDERSTAND-THIS-IS-LIVE
